{{!
    @template tool_abconfig/form-user-selector-suggestion

    Template for the list of selected options in an autocomplate form element.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * profileimageurlsmall Url to a small profile image.
    * fullname Users full name

    Example context (json):

    {
        "id": "1",
        "fullname": "Kermit Thefrog",
        "profileimageurlsmall": "https://example.org/img",
        "hasidentity": "true",
        "identity": "admin@example.com, 0144114141"
    }
}}
<span>
    <img height="12" src="{{profileimageurlsmall}}" alt="">
    <span>{{fullname}}</span>
    {{#hasidentity}}
        <span><small>{{identity}}</small></span>
    {{/hasidentity}}
</span>
